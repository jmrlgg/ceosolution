---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import TestimonialCarousel from './TestimonialCarousel.astro';
import type { Testimonial } from '../data/site';

interface Props {
  image: ImageMetadata;
  testimonials: Testimonial[];
  /** Darken the background image (0–1). */
  overlay?: number;
}
const { image, testimonials, overlay = 0.35 } = Astro.props;
---
<section class="hero">
  <div class="hero__media">
    <Image src={image} alt="" widths={[640, 960, 1280]} sizes="(max-width: 900px) 100vw, 63vw" loading="eager" fetchpriority="high" />
    <div class="hero__shade" style={`--overlay:${overlay}`}></div>
    <div class="hero__content">
      <slot />
    </div>
  </div>
  <div class="hero__panel">
    <TestimonialCarousel items={testimonials} />
  </div>
</section>

<style>
  .hero { display: grid; grid-template-columns: 63fr 37fr; min-height: 440px; }
  .hero__media { position: relative; overflow: hidden; display: flex; align-items: center; }
  .hero__media :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero__shade { position: absolute; inset: 0; background: rgba(0, 0, 0, var(--overlay)); }
  .hero__content { position: relative; z-index: 1; padding: 48px 40px 48px max(40px, calc((100vw - var(--container)) / 2 + 20px)); color: var(--c-white); max-width: 720px; }
  .hero__content :global(h1) { color: var(--c-white); font-size: clamp(2rem, 4vw, 3rem); line-height: 1.12; margin: 0 0 12px; }
  .hero__panel { background: var(--c-teal); display: flex; align-items: center; justify-content: center; padding: 40px 32px; }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; }
    .hero__media { min-height: 380px; }
    .hero__content { padding: 40px 20px; }
    .hero__panel { padding: 36px 20px; }
  }
</style>
