---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';
import Icon from './Icon.astro';
import Button from './Button.astro';
import { nav, site } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const socials = [
  { name: 'facebook', label: 'Facebook', href: site.social.facebook },
  { name: 'instagram', label: 'Instagram', href: site.social.instagram },
  { name: 'linkedin', label: 'LinkedIn', href: site.social.linkedin },
] as const;
---
<div class="topbar">
  <div class="container topbar__inner">
    <span class="topbar__hours">{site.hours}</span>
    <ul class="topbar__social">
      {socials.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener">
            <Icon name={s.name} size={16} />
            <span>{s.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>

<header class="header">
  <div class="container header__inner">
    <a href="/" class="header__logo" aria-label={`${site.shortName} home`}>
      <Image src={logo} alt="Your CEO Solution logo" width={180} loading="eager" />
    </a>

    <button class="header__toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
      <Icon name="menu" size={26} class="icon-open" />
      <Icon name="close" size={26} class="icon-close" />
    </button>

    <nav id="site-nav" class="header__nav" aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
      <Button href="/contact" variant="bright" size="lg">Contact Us</Button>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.header__toggle');
  const header = document.querySelector('.header');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    header?.classList.toggle('is-open', !open);
  });
</script>

<style>
  .topbar { background: var(--c-teal); color: var(--c-white); }
  .topbar__inner { display: flex; align-items: center; justify-content: space-between; min-height: 40px; gap: 16px; }
  .topbar__hours { font-size: 0.8rem; opacity: 0.9; }
  .topbar__social { list-style: none; display: flex; gap: 10px; margin: 0; padding: 4px 0; }
  .topbar__social a { display: flex; flex-direction: column; align-items: center; gap: 2px; font-size: 0.6rem; text-decoration: none; }
  .topbar__social a:hover { opacity: 0.8; }

  .header { background: var(--c-white); position: sticky; top: 0; z-index: 50; box-shadow: 0 1px 0 rgba(0,0,0,0.06); }
  .header__inner { display: flex; align-items: center; justify-content: space-between; min-height: 88px; gap: 24px; }
  .header__logo img { width: 110px; height: auto; }

  .header__nav { display: flex; align-items: center; gap: 24px; }
  .header__nav ul { list-style: none; display: flex; gap: 18px; margin: 0; padding: 0; }
  .header__nav ul a { text-decoration: none; color: var(--c-text); font-size: 0.95rem; padding: 6px 0; border-bottom: 2px solid transparent; }
  .header__nav ul a:hover, .header__nav ul a[aria-current='page'] { color: var(--c-teal); border-color: var(--c-teal); }

  .header__toggle { display: none; background: none; border: 0; color: var(--c-teal); cursor: pointer; padding: 6px; }
  .header__toggle :global(.icon-close) { display: none; }

  @media (max-width: 820px) {
    .header__toggle { display: block; }
    .header__nav {
      display: none;
      position: absolute; left: 0; right: 0; top: 100%;
      flex-direction: column; align-items: stretch; gap: 16px;
      background: var(--c-white); padding: 16px 20px 24px;
      box-shadow: 0 10px 20px rgba(0,0,0,0.08);
    }
    .header__nav ul { flex-direction: column; gap: 4px; }
    .header__nav ul a { display: block; padding: 10px 0; font-size: 1.05rem; }
    .header.is-open .header__nav { display: flex; }
    .header.is-open :global(.icon-open) { display: none; }
    .header.is-open :global(.icon-close) { display: block; }
    .topbar__hours { font-size: 0.72rem; }
  }
</style>
