---
import Button from './Button.astro';
import Icon from './Icon.astro';
import { faqs } from '../data/site';
---
<section class="section" id="faq">
  <div class="container faq">
    <div class="faq__intro">
      <h2>Frequently Asked Questions</h2>
      <p>Have questions about how we work or what to expect? Our FAQ section covers the most common topics to help you make informed decisions. Explore the answers below or reach out if you need more details we’re here to support your business growth.</p>
      <Button href="/contact">Contact Us</Button>
    </div>
    <div class="faq__list">
      {faqs.map((f) => (
        <details>
          <summary><Icon name="chevron" size={20} /> {f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { display: grid; grid-template-columns: 0.8fr 1fr; gap: 56px; align-items: start; }
  .faq__intro h2 { font-size: clamp(1.8rem, 3vw, 2.25rem); max-width: 320px; }
  .faq__intro p { font-size: 0.85rem; color: var(--c-muted); line-height: 1.7; }
  .faq__list {
    border: 1px solid var(--c-teal);
    border-radius: 0 60px 0 60px;
    padding: 26px 26px 34px;
  }
  details { border-top: 1px solid var(--c-teal); }
  details:last-child { border-bottom: 1px solid var(--c-teal); }
  summary {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 10px; cursor: pointer; list-style: none;
    font-weight: 700; font-size: 0.95rem; color: var(--c-ink);
  }
  summary::-webkit-details-marker { display: none; }
  summary :global(svg) { flex-shrink: 0; transition: transform 0.2s ease; }
  details[open] summary :global(svg) { transform: rotate(180deg); }
  details p { padding: 0 10px 14px 42px; margin: 0; font-size: 0.9rem; color: var(--c-muted); }

  @media (max-width: 820px) {
    .faq { grid-template-columns: 1fr; gap: 28px; }
    .faq__list { border-radius: 0 36px 0 36px; padding: 16px 12px 22px; }
  }
</style>
