---
import Icon from './Icon.astro';

interface Props {
  href: string;
  /** Small second line under the label, e.g. "Find your smartest next move!" */
  sub?: string;
  variant?: 'teal' | 'light' | 'bright';
  size?: 'md' | 'lg';
  /** Show the circled arrow after the label (default true). */
  arrow?: boolean;
  /** Show a people icon before the label (used by "90-Day Escape Plan"). */
  leadingIcon?: boolean;
  shape?: 'pill' | 'rect';
  target?: string;
}
const {
  href,
  sub,
  variant = 'teal',
  size = 'md',
  arrow = true,
  leadingIcon = false,
  shape = 'pill',
  target,
} = Astro.props;
const external = /^https?:|\.pdf$/.test(href);
---
<a
  href={href}
  class:list={['btn', `btn--${variant}`, `btn--${size}`, `btn--${shape}`, { 'btn--stacked': sub }]}
  target={target ?? (external ? '_blank' : undefined)}
  rel={external ? 'noopener' : undefined}
>
  <span class="btn__main">
    {leadingIcon && <Icon name="users" size={16} />}
    <slot />
    {arrow && <Icon name="arrow-circle" size={18} />}
  </span>
  {sub && <span class="btn__sub">{sub}</span>}
</a>

<style>
  .btn {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    font-weight: 700;
    text-decoration: none;
    line-height: 1.2;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
  }
  .btn:hover { transform: translateY(-1px); box-shadow: var(--shadow); }
  .btn__main { display: inline-flex; align-items: center; gap: 6px; }
  .btn__sub { font-size: 0.72em; font-weight: 700; opacity: 0.95; }

  .btn--md { font-size: 1rem; padding: 9px 22px; }
  .btn--lg { font-size: 1.1rem; padding: 12px 26px; }
  .btn--stacked { padding-block: 10px; }

  .btn--pill { border-radius: 999px; }
  .btn--rect { border-radius: 4px; }

  .btn--teal { background: var(--c-teal); color: var(--c-white); }
  .btn--teal:hover { background: #196868; }
  .btn--bright { background: var(--c-teal-bright); color: var(--c-white); }
  .btn--bright:hover { background: #24909a; }
  .btn--light { background: var(--c-white); color: var(--c-teal); }
</style>
